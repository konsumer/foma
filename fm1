#!/bin/sh
# foma: everything runs in Docker, nothing else to install.
#   ./fm1 new NAME make this copy your own firmware (once): ./fm1 new "MY SYNTH" [--repo URL]
#   ./fm1 dev      build, serve the emulator + installer on http://localhost:8000, rebuild on save
#   ./fm1 build    build/web (the site) and build/NAME-VERSION.fwsc (the FM-1 package)
#   ./fm1 fmt      format the code (clang-format, prettier, ruff)
#   ./fm1 shell    a shell in the toolchain container
#   ./fm1 image    build the toolchain image here (instead of pulling it)
#   ./fm1 clean    remove build/
set -e
cd "$(dirname "$0")"
IMAGE="${FOMA_IMAGE:-konsumer/foma-toolchain}"
PORT="${PORT:-8000}"

image() {
  [ -f Dockerfile ] || { echo "fm1: no Dockerfile here; the image comes from Docker Hub ($IMAGE)"; exit 1; }
  docker build --platform linux/amd64 -t "$IMAGE" .
}

run() {
  docker info >/dev/null 2>&1 || { echo "fm1: Docker is not running"; exit 1; }
  docker image inspect "$IMAGE" >/dev/null 2>&1 || docker pull --platform linux/amd64 "$IMAGE" || image
  TTY=""
  [ -t 0 ] && [ -t 1 ] && TTY="-it"
  # shellcheck disable=SC2086
  docker run --rm --init $TTY --platform linux/amd64 -u "$(id -u):$(id -g)" -v "$PWD:/work" $PORTS "$IMAGE" "$@"
}

case "${1:-build}" in
  new)
    shift
    [ -f tools/new.py ] || { echo "fm1: this project is already yours (tools/new.py is gone)"; exit 1; }
    run python3 tools/new.py "$@"
    ;;
  build) run python3 tools/build.py ;;
  dev) PORTS="-p $PORT:$PORT" run python3 tools/build.py --dev "$PORT" ;;
  fmt) run sh -c 'clang-format -i src/*.c platform/*.c platform/*.h && npx -y prettier -w "web/*.{html,js,css}" "*.json" && ruff format tools' ;;
  shell) run bash ;;
  image) image ;;
  clean) rm -rf build ;;
  *) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
